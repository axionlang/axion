cabal-version:      3.0
name:               axion-prototype
version:            0.0.0
synopsis:           Phase 0 — disposable EDSL prototype for Axion's semantic validation
description:
  Semantic validation bench for the Axion language (spec §17), NOT the embryo of
  the compiler. Uses GHC's LinearTypes extension + linear-base to validate the
  linear %1 core (levels L0/L1): a @Buffer %1@ that the typechecker refuses to use
  twice. Disposable by design; the real axionc (in Rust) is born in Phase 1.

license:            NONE
author:             Axion
build-type:         Simple
extra-doc-files:    README.md

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   prototype/src
  default-language: GHC2021
  build-depends:
    , base        >=4.16 && <5
    , linear-base
    , vector
  exposed-modules:
    Axion.Prototype.Buffer
    Axion.Prototype.Examples

executable axion-prototype
  import:           warnings
  hs-source-dirs:   prototype/app
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
    , base
    , axion-prototype
    , linear-base

test-suite prototype-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   prototype/test
  main-is:          Spec.hs
  default-language: GHC2021
  build-depends:
    , base
    , axion-prototype
    , linear-base
    , tasty
    , tasty-hunit
    , tasty-quickcheck
